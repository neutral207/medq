#login/logout
USERS = {
    "ADM1": {"password": "admin123", "role": "admin"},
    "STF1001": {"password": "staffpass1", "role": "staff"},
}

@api_bp.get('/login')
def login():
    data = request.get_json(force=True, silent=True) or {}
    employee_number = data.get("employee_number")
    password = data.get("password")

    user = USERS.get(employee_number)
    if not user or user["password"] != password:
        return jsonify({"message": "Invalid employee number or password"}),

    token = create_access_token(
        identity={"employee_number": employee_number, "role": user["role"]},
        expires_delta= timedelta(hours1)
    )

    return jsonify({
        "message": f"{user['role'].capitalize()} login successfully",
        "role": user["role"],
        "token" : token
    }), 200

@api_bp.post('/logout')
def logout():
    return jsonify({"message": "Logged out successfully"}), 200