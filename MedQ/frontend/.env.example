# API Configuration
# Backend API base URL (required for production)
# Development default: http://localhost:5000/api
# Production: Set this to your backend API URL
VITE_API_BASE_URL=

# Backend WebSocket URL (required for production)
# Development default: http://localhost:5000
# Production: Set this to your backend URL (without /api)
VITE_API_URL=

# Base URL for the application (used for QR codes and sharing links)
# If not set, will default to window.location.origin
# For mobile access on LAN, set this to your PC's LAN IP address
# Example: VITE_APP_URL=http://192.168.1.147:3000
VITE_APP_URL=
