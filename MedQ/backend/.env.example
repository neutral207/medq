# JWT Configuration
# Generate your own secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_secret_key_here_change_this
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=8

# Database Configuration (if not using docker-compose defaults)
# These are optional - docker-compose.yml has defaults
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=medq
# DB_USER=postgres
# DB_PASSWORD=postgres
